{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.itzbandhan.tech" }],
      "destination": "https://itzbandhan.tech/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!assets/|favicon\\.svg|favicon\\.png|robots\\.txt|sitemap\\.xml|manifest\\.webmanifest|og-image\\.png|.*\\..*).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
